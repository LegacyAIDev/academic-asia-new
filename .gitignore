# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# npm is the package manager; its lockfile is committed so installs are
# reproducible. Other managers' lockfiles are not used.
yarn.lock
pnpm-lock.yaml

# testing
/coverage
.nyc_output

# next.js / vercel
/.next/
/out/
/build
dist/
bin/
.vercel
next-env.d.ts
*.tsbuildinfo

# env files (opt in with .env.example)
.env*
!.env.example

# editors and OS
.DS_Store
.idea/
~$*
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs.txt

# local tooling
repomix-output.xml
.serena/cache
.gemini/settings.json
.claude/settings.bak.json
test-ck
__pycache__
prompt.md

# working notes kept out of the repo
plans/**/*
!plans/templates/*
screenshots/*
docs/screenshots/*
docs/journals/*
docs/research/*

# Legacy file dumps — student/school PII. Never commit.
# Also required for the build: Tailwind v4 auto-scans every path not listed
# here, and tries to parse these PDFs/BMPs as source files.
studentdatafile/
school-files/

# Staff credentials — never commit
data/staff-credentials.json
data/staff-credentials.txt
