# Copy to .env.local and fill in. Values come from the Supabase dashboard:
# Project Settings -> API Keys (and Database for the password).

# Supabase project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable (browser) key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key. Server-only: staff and permission admin actions, cached
# reference lists, and the scripts. SUPABASE_SERVICE_ROLE_KEY is also accepted.
SUPABASE_SECRET_KEY=

# FullCalendar Premium licence for the Scheduler. Empty uses the evaluation key.
NEXT_PUBLIC_FULLCALENDAR_LICENSE_KEY=

# Database password, for applying migrations with psql (not read by the app).
SUPABASE_DB_PASSWORD=
